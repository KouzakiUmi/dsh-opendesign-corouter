{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "types": ["node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
